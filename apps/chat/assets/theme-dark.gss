/* ==========================================================================
   guirs chat

   Edit this while the application is running. It is watched and reloaded.
   ========================================================================== */

:root {
    --bg:            #0d0d0f;
    --sidebar:       #111113;
    --surface:       #1a1a1d;
    --surface-high:  #232327;
    --raised:        #2a2a2f;

    --text:          #ededf0;
    --text-soft:     #a8a8b3;
    --text-faint:    #6e6e7a;

    --line:          #232327;
    --line-soft:     #1c1c20;

    --accent:        #10a37f;
    --accent-high:   #1cb992;
    --accent-soft:   rgba(16, 163, 127, 0.16);

    /* Inline spans inside a reply. */
    --code-text:     #d6e2ff;
    --code-surface:  rgba(237, 237, 240, 0.08);
    --link:          #7aa2ff;

    --selection:     rgba(16, 163, 127, 0.30);
    --caret:         #ededf0;
    /* How long the caret spends lit, and then dark. `none` keeps it solid. */
    --caret-blink:   530ms;
    --caret-width:   1.5px;
    --caret-radius:  1px;
    --scrollbar-thumb: rgba(237, 237, 240, 0.14);
    --scrollbar-track: transparent;

    --radius-sm:     6px;
    --radius:        10px;
    --radius-lg:     16px;
    --speed:         130ms;
}

.root {
    background: var(--bg);
    color: var(--text);
    font-family: "Segoe UI Variable Text", "Segoe UI", "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 14px;
    line-height: 1.55;
}

/* --------------------------------------------------------------------------
   Window bar

   Drawn by the application, because the platform title bar is turned off.
   Dragging it moves the window and double clicking it maximizes.
   -------------------------------------------------------------------------- */

titlebar.window-bar {
    height: 40px;
    padding: 0 0 0 12px;
    gap: 9px;
    background: var(--sidebar);
    border-bottom: 1px solid var(--line);
}

.window-brand {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.1px;
}

.window-stats {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    color: var(--text-faint);
    margin-right: 10px;
}

.window-title {
    font-size: 12px;
    color: var(--text-faint);
    margin-left: 6px;
}

window-controls { height: 40px; }

window-button {
    width: 44px;
    height: 40px;
    color: var(--text-soft);
    font-size: 13px;
    transition: background var(--speed) ease-out, color var(--speed) ease-out;
}

window-button icon { width: 13px; height: 13px; }

window-button:hover        { background: var(--surface-high); color: var(--text); }
window-button.close:hover  { background: #d3312a; color: #ffffff; }

/* --------------------------------------------------------------------------
   Sidebar
   -------------------------------------------------------------------------- */

.sidebar {
    width: 268px;
    background: var(--sidebar);
    border-right: 1px solid var(--line);
    padding: 12px;
    gap: 8px;
}

.brand-mark {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: linear-gradient(140deg, var(--accent-high), var(--accent));
}

.new-chat {
    padding: 9px 11px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: none;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    transition: background var(--speed) ease-out, border-color var(--speed) ease-out;
}

.new-chat:hover { background: var(--surface); border-color: var(--raised); }
.new-chat-icon  { color: var(--text-soft); width: 16px; height: 16px; }

.sidebar-label {
    padding: 10px 10px 2px 10px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-faint);
    letter-spacing: 0.7px;
}

.conversation-list { gap: 2px; }

.conversation {
    padding: 8px 11px;
    border-radius: var(--radius);
    transition: background var(--speed) ease-out;
}

.conversation:hover { background: var(--surface); }
.conversation.active { background: var(--surface-high); }

.conversation-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
}

.conversation-preview {
    font-size: 12px;
    color: var(--text-faint);
    line-height: 1.35;
}

.account {
    padding: 9px 10px;
    border-radius: var(--radius);
    border-top: 1px solid var(--line-soft);
    margin-top: 4px;
}

.avatar-small {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: linear-gradient(140deg, #6c5ce7, #4834b8);
}

.avatar-glyph { width: 15px; height: 15px; color: #ffffff; }

.account-name { font-size: 13px; font-weight: 500; }
.account-plan { font-size: 11px; color: var(--text-faint); }

/* --------------------------------------------------------------------------
   Header
   -------------------------------------------------------------------------- */

.header {
    height: 54px;
    padding: 0 18px;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
}

.header-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.1px;
}

.header-meta { font-size: 12px; color: var(--text-faint); }

.icon-button {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 15px;
    transition: background var(--speed) ease-out, color var(--speed) ease-out,
                transform 90ms ease-out;
}

.icon-button:hover  { background: var(--surface-high); color: var(--text); }
/* A press gives back a little. Transforms are a paint step, so this costs no
   layout and moves nothing around it. */
.icon-button:active { transform: scale(0.90); }
.icon-button icon   { width: 17px; height: 17px; }

/* The extra control in the window bar sits with the platform ones. */
.window-extra { width: 28px; height: 28px; }
.window-extra icon { width: 15px; height: 15px; }

/* Attaching a file, next to the send button. */
.attach { width: 30px; height: 30px; }

/* --------------------------------------------------------------------------
   Transcript
   -------------------------------------------------------------------------- */

.thread { background: var(--bg); }

.thread-inner {
    padding: 26px 26px 8px 26px;
    gap: 26px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
}

.turn { width: 100%; }

.avatar {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: linear-gradient(140deg, var(--accent-high), var(--accent));
    margin-top: 20px;
}

.avatar-you { background: linear-gradient(140deg, #6c5ce7, #4834b8); }

.turn-role {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-faint);
    letter-spacing: 0.4px;
}

.bubble {
    padding: 11px 15px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    max-width: 640px;
}

.bubble-you {
    background: var(--accent-soft);
    border-color: rgba(16, 163, 127, 0.30);
}

.bubble-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text);
    white-space: pre-wrap;
}

/* The block that follows a reply while it is still arriving. */
.caret {
    width: 8px;
    height: 15px;
    margin-top: 3px;
    border-radius: 2px;
    background: var(--accent);
}

/* --------------------------------------------------------------------------
   Empty state
   -------------------------------------------------------------------------- */

.empty { gap: 12px; }

.empty-mark {
    width: 46px;
    height: 46px;
    border-radius: 15px;
    background: linear-gradient(140deg, var(--accent-high), var(--accent));
    box-shadow: 0 10px 30px rgba(16, 163, 127, 0.28);
}

.empty-title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.2px;
}

.empty-hint {
    font-size: 13px;
    color: var(--text-faint);
    line-height: 1.6;
}

/* --------------------------------------------------------------------------
   Composer
   -------------------------------------------------------------------------- */

.composer {
    padding: 12px 26px 18px 26px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
}

.composer-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 6px 6px 6px 6px;
    transition: border-color var(--speed) ease-out, background var(--speed) ease-out;
}

.composer-box:hover        { border-color: var(--raised); }
.composer-box:focus-within { border-color: var(--accent); background: var(--surface-high); }

input.composer-input {
    background: none;
    border: none;
    height: 38px;
    min-width: 120px;
    padding: 0 10px;
    font-size: 14px;
    box-shadow: none;
}

input.composer-input:hover { border-color: transparent; }
input.composer-input:focus { border-color: transparent; box-shadow: none; }

.send {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--raised);
    color: var(--text-faint);
    transition: background var(--speed) ease-out, color var(--speed) ease-out,
                transform 90ms ease-out;
}

.send.ready        { background: var(--accent); color: #ffffff; }
.send.ready:hover  { background: var(--accent-high); }
.send.ready:active { transform: scale(0.92); }

.send-icon { width: 17px; height: 17px; }

.composer-hint {
    padding-left: 4px;
    font-size: 11px;
    color: var(--text-faint);
}
